        "modality": "audiovisual",
        "uri": "s3://medsimqa-corpus/sim-consult-0042.mp4",
        "duration_seconds": 412.5,
        "checksum": "sha256:9f2c1a7e4b6d8f03a5c7e9b1d3f5a7c9e1b3d5f7a9c1e3b5d7f9a1c3e5b7d9f1",
        "sample_rate_hz": 48000,
        "channels": 2,
