{
  "name": "medsimqa-e2e",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "End-to-end, localization, layout and network-resilience suite for the MedSimQA dashboard",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:mobile": "cypress run --config viewportWidth=360,viewportHeight=740",
    "test": "cypress run --reporter spec",
    "test:layout": "cypress run --spec 'cypress/e2e/03-layout-and-regional-formatting.cy.ts'",
    "test:network": "cypress run --spec 'cypress/e2e/04-network-interception.cy.ts'"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "typescript": "^5.6.2"
  }
}
